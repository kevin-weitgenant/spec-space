    "sidebar"
  ],
  "license": "MIT",
  "author": "Kevin Weitgenant",
  "homepage": "https://github.com/kevin-weitgenant/spec-space#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevin-weitgenant/spec-space.git"
  },
  "bugs": {
    "url": "https://github.com/kevin-weitgenant/spec-space/issues"
  },
  "type": "commonjs",
  "bin": {
    "spec-space": "src/cli/serve.js"
  },
  "main": "./src/cli/serve.js",
  "files": [
